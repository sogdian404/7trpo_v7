<Page x:Class="_7_wpf.Pages.EditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      
      xmlns:local="clr-namespace:_7_wpf.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <StackPanel  Margin="10" Width="300" HorizontalAlignment="Left">
            <Label Style="{DynamicResource MaterialDesignLabel}">Выбранный объект</Label>
            <TextBlock Style="{DynamicResource MaterialDesignTextBlock}" Background="AliceBlue" Margin="0 5" Text="{Binding Name}"></TextBlock>
            <TextBlock Style="{DynamicResource MaterialDesignTextBlock}" Background="AliceBlue" Margin="0 5" Text="{Binding City}"></TextBlock>
            <md:NumericUpDown Minimum="0" Maximum="5" Background="AliceBlue" Margin="0 5" Value="{Binding Rating}"></md:NumericUpDown>
            <md:NumericUpDown Minimum="0" Background="AliceBlue" Margin="0 5" Value="{Binding PricePerNight}"></md:NumericUpDown>
            <StackPanel Background="AliceBlue" Margin="0 5" Orientation="Horizontal">
                <CheckBox Style="{DynamicResource MaterialDesignCheckBox}" IsChecked="{Binding IsAvailable}"></CheckBox>
                <Label Style="{DynamicResource MaterialDesignLabel}" Margin="0 5">Доступен</Label>
            </StackPanel>
            <Button x:Name="edit" Click="edit_Click">Изменить</Button>
        </StackPanel>
    
    
    </Grid>
</Page>
