<Page x:Class="_7_wpf.Pages.EditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      
      xmlns:local="clr-namespace:_7_wpf.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border  Grid.Row="0" Background="AliceBlue">
        <TextBlock  FontSize="18" FontWeight="Bold" Margin="10" Text="{Binding Header}"/>
        </Border>
        <Border Grid.Row="1" Background="GhostWhite">
        <StackPanel  Background="GhostWhite" Margin="10" Width="320" HorizontalAlignment="Left">
            <TextBox Margin="5" md:HintAssist.Hint="Название" IsReadOnly="{Binding IsReadOnly}" Text="{Binding HotelName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" md:HintAssist.Hint="Город" IsReadOnly="{Binding IsReadOnly}" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
            <md:NumericUpDown Minimum="0" Maximum="5" Margin="5"  Value="{Binding Rating}"/>
            <md:NumericUpDown Minimum="0" Margin="5" Value="{Binding PricePerNight}"/>
            <CheckBox Content="Доступен" Margin="5" IsChecked="{Binding IsAvailable}"/>
        </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="AliceBlue">
            <StackPanel  Orientation="Horizontal" Margin="10" VerticalAlignment="Top">
                <Button MinWidth="120" Margin="10 0" Click="edit_Click">Сохранить</Button>
                <Button MinWidth="120" Margin="10 0" Click="Cancel_Click">Отмена</Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
