<Window x:Class="_7_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:_7_wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition  Height="auto"></RowDefinition>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="5">
            <TextBox Margin="0 5" md:HintAssist.Hint="Город" x:Name="city" Text="{Binding CityFilter, UpdateSourceTrigger=PropertyChanged}" ></TextBox>
            <TextBox Margin="0 5" md:HintAssist.Hint="Минимальный рейтинг" Text="{Binding MinRatingFilter, UpdateSourceTrigger=PropertyChanged}" x:Name="minRating" ></TextBox>
            <Button MinWidth="100" Margin="5 0" Name="Getall" Click="Getall_Click">Обновить список</Button>
        </StackPanel>
        <StackPanel VerticalAlignment="Top" Grid.Column="1" Orientation="Horizontal" Margin="5" Grid.ColumnSpan="2">
            <Button MinWidth="100" Margin="5 0" Name="Create" Click="Create_Click">Создать</Button>
            <Button MinWidth="100" Margin="5 0" Name="Edit" Click="Edit_Click">Патч</Button>
            <Button MinWidth="100" Margin="5 0" Name="Swap" Click="Swap_Click">Заменить</Button>
            <Button MinWidth="100" Margin="5 0" Name="Delete" Click="Delete_Click">Удалить</Button> 
            
        </StackPanel>
        <ListView Grid.Row="1" Loaded="ListView_Loaded" ItemsSource="{Binding hotels}" MouseDoubleClick="ListView_MouseDoubleClick" SelectedItem="{Binding SelectedHotel, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Foreground="Red" Text="{Binding Name}"/>
                            <TextBlock Text="{Binding City, StringFormat=Город: {0}}"/>
                            <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}"/>
                            <TextBlock Text="{Binding PricePerNight, StringFormat=Цена: {0}}"/>
                            <TextBlock Text="{Binding IsAvailable, StringFormat=Доступен: {0}}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Frame x:Name="MainFrame" Grid.Column="1" Grid.Row="1" NavigationUIVisibility="Hidden" Source="Pages/MainPage.xaml"/>

    </Grid>
</Window>
