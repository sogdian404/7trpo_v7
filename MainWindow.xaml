<Window x:Class="_7_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:_7_wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition  Height="120"></RowDefinition>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Frame Grid.Column="1" Grid.Row="1" NavigationUIVisibility="Hidden" Source="Pages/MainPage.xaml"/>

        <StackPanel Margin="5">
            <TextBox Margin="0 5" md:HintAssist.Hint="Город" x:Name="city" ></TextBox>
            <TextBox Margin="0 5" md:HintAssist.Hint="минимальный рейтинг" x:Name="minRating" ></TextBox>
            <Button MinWidth="100" Margin="5 0" Name="Getall" Click="Getall_Click">Обновить список</Button>
        </StackPanel>
        <StackPanel VerticalAlignment="Top" Grid.Column="1" Orientation="Horizontal" Margin="5" Grid.ColumnSpan="2">
            <Button MinWidth="100" Margin="5 0" Name="Edit">Патч</Button>
            <Button MinWidth="100" Margin="5 0" Name="Swap">Заменить</Button>
            <Button MinWidth="100" Margin="5 0" Name="Delete">Удалить</Button> 
            
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding hotels}" MouseDoubleClick="ListView_MouseDoubleClick" SelectedItem="{Binding hotel}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Foreground="Red" Text="{Binding Name}"/>
                            <TextBlock Text="{Binding City}"/>
                            <TextBlock Text="{Binding Rating}"/>
                            <TextBlock Text="{Binding PricePerNight}"/>
                            <TextBlock Text="{Binding IsAvailable}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
